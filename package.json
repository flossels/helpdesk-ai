{
  "name": "helpdesk-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "validate": "tsc --noEmit && pnpm lint && pnpm format:check && pnpm knip && pnpm test:run",
    "verify": "pnpm validate && pnpm build",
    "validate:fix": "pnpm lint:fix && pnpm format",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:reset": "ENV_FILE=.env.test prisma migrate reset --force && ENV_FILE=.env.test tsx prisma/seed.ts",
    "analyze": "next experimental-analyze",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.86",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sesv2": "^3.1117.0",
    "@aws-sdk/s3-presigned-post": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/static-renderer": "^3.30.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.83",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "flags": "^4.2.4",
    "ioredis": "^6.0.0",
    "mixpanel": "^0.23.0",
    "mixpanel-browser": "^2.81.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "qs": "^6.15.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.1",
    "react-email": "^6.9.2",
    "react-hook-form": "^7.86.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/playwright": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/qs": "^6.15.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
